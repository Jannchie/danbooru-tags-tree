{
  "name": "danbooru-tags-tree-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build:data": "tsx scripts/build-data.ts",
    "build": "pnpm build:data && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint --vue-plugin --vitest-plugin .",
    "lint:fix": "oxlint --vue-plugin --vitest-plugin --fix ."
  },
  "dependencies": {
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-types": "^0.24.8",
    "sigma": "^3.0.2",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.6.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.8.1",
    "jsdom": "^27.0.1",
    "oxlint": "^1.56.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "npm:rolldown-vite@7.3.1",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.1.1"
  },
  "packageManager": "pnpm@10.18.3"
}
